rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['username', 'displayName', 'bio', 'updatedAt'])
        && data.keys().hasOnly(['username', 'displayName', 'bio', 'updatedAt'])
        && data.username is string
        && data.username.matches('^[a-z0-9_]{3,24}$')
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 40
        && data.bio is string
        && data.bio.size() <= 160
        && data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid);
      allow delete: if signedIn() && request.auth.uid == uid;

      match /following/{targetUid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && targetUid != uid
          && exists(/databases/$(database)/documents/profiles/$(targetUid))
          && request.resource.data.keys().hasAll(['uid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == targetUid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && resource.data.uid == targetUid;
        allow update: if false;
      }

      match /videoSignals/{videoId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['videoId', 'title', 'keywords', 'views', 'liked', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['videoId', 'title', 'keywords', 'views', 'liked', 'updatedAt', 'lastViewedAt'])
          && request.resource.data.videoId == videoId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.keywords is list
          && request.resource.data.keywords.size() <= 30
          && request.resource.data.views is int
          && request.resource.data.views >= 0
          && request.resource.data.liked is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'content', 'isAiGenerated', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorUsername', 'content', 'isAiGenerated', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 40
        && (!('authorUsername' in request.resource.data) || (request.resource.data.authorUsername is string && request.resource.data.authorUsername.matches('^[a-z0-9_]{3,24}$')))
        && (!('authorUsername' in request.resource.data) || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.authorUsername)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.isAiGenerated is bool
        && (!('type' in request.resource.data) || request.resource.data.type == 'comment')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && request.resource.data.keys().hasAll(['uid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && resource.data.uid == uid;
        allow update: if false;
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && request.resource.data.keys().hasAll(['uid', 'authorName', 'content', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'content', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 40
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
