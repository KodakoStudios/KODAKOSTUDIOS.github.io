rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function developerUid() {
      return 'f1Xr5FotQSVnuDx7nPMHzsNRwPy2';
    }

    function blockedEitherWay(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/profiles/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/profiles/$(secondUid)/blocked/$(firstUid));
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['username', 'displayName', 'bio', 'updatedAt'])
        && data.keys().hasOnly(['username', 'displayName', 'bio', 'avatarId', 'customAvatarDataUrl', 'updatedAt'])
        && data.username is string
        && data.username.matches('^[a-z0-9_]{3,24}$')
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 40
        && data.bio is string
        && (data.bio.size() <= 160 || (uid == developerUid() && data.bio.size() <= 2000))
        && (!('avatarId' in data) || data.avatarId in ['google', 'octopus', 'star', 'cat', 'rabbit', 'bear', 'flower', 'custom'])
        && (!('customAvatarDataUrl' in data) || (data.customAvatarDataUrl is string && data.customAvatarDataUrl.size() <= 280000 && data.customAvatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')))
        && (!('avatarId' in data) || data.avatarId != 'custom' || 'customAvatarDataUrl' in data)
        && data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data, uid);
      allow delete: if signedIn() && request.auth.uid == uid;

      match /following/{targetUid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && targetUid != uid
          && exists(/databases/$(database)/documents/profiles/$(targetUid))
          && (targetUid == developerUid()
            || (!exists(/databases/$(database)/documents/profiles/$(uid)/blocked/$(targetUid))
              && !exists(/databases/$(database)/documents/profiles/$(targetUid)/blocked/$(uid))))
          && existsAfter(/databases/$(database)/documents/profiles/$(targetUid)/followers/$(uid))
          && request.resource.data.keys().hasAll(['uid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == targetUid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && targetUid != developerUid()
          && (request.auth.uid == uid || (request.auth.uid == targetUid && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)/blocked/$(uid))))
          && !existsAfter(/databases/$(database)/documents/profiles/$(targetUid)/followers/$(uid))
          && resource.data.uid == targetUid;
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == followerUid
          && existsAfter(/databases/$(database)/documents/profiles/$(followerUid)/following/$(uid))
          && request.resource.data.keys().hasAll(['uid', 'targetUid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'targetUid', 'createdAt'])
          && request.resource.data.uid == followerUid
          && request.resource.data.targetUid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && uid != developerUid()
          && (request.auth.uid == followerUid || (request.auth.uid == uid && existsAfter(/databases/$(database)/documents/profiles/$(uid)/blocked/$(followerUid))))
          && !existsAfter(/databases/$(database)/documents/profiles/$(followerUid)/following/$(uid))
          && resource.data.uid == followerUid;
        allow update: if false;
      }

      match /blocked/{targetUid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == targetUid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && targetUid != uid
          && exists(/databases/$(database)/documents/profiles/$(targetUid))
          && request.resource.data.keys().hasAll(['targetUid', 'slotId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['targetUid', 'slotId', 'createdAt'])
          && request.resource.data.targetUid == targetUid
          && (request.resource.data.slotId.matches('^0[0-9]$')
            || (request.auth.uid == developerUid() && request.resource.data.slotId.matches('^[0-4][0-9]$')))
          && getAfter(/databases/$(database)/documents/profiles/$(uid)/blockSlots/$(request.resource.data.slotId)).data.targetUid == targetUid
          && existsAfter(/databases/$(database)/documents/profiles/$(targetUid)/blockedBy/$(uid))
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && !existsAfter(/databases/$(database)/documents/profiles/$(targetUid)/blockedBy/$(uid))
          && !existsAfter(/databases/$(database)/documents/profiles/$(uid)/blockSlots/$(resource.data.slotId));
        allow update: if false;
      }

      match /blockedBy/{blockerUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == blockerUid
          && existsAfter(/databases/$(database)/documents/profiles/$(blockerUid)/blocked/$(uid))
          && request.resource.data.keys().hasAll(['blockerUid', 'targetUid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['blockerUid', 'targetUid', 'createdAt'])
          && request.resource.data.blockerUid == blockerUid
          && request.resource.data.targetUid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && request.auth.uid == blockerUid
          && !existsAfter(/databases/$(database)/documents/profiles/$(blockerUid)/blocked/$(uid));
        allow update: if false;
      }

      match /blockSlots/{slotId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && (slotId.matches('^0[0-9]$')
            || (request.auth.uid == developerUid() && slotId.matches('^[0-4][0-9]$')))
          && request.resource.data.keys().hasAll(['targetUid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['targetUid', 'createdAt'])
          && existsAfter(/databases/$(database)/documents/profiles/$(uid)/blocked/$(request.resource.data.targetUid))
          && getAfter(/databases/$(database)/documents/profiles/$(uid)/blocked/$(request.resource.data.targetUid)).data.slotId == slotId
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && !existsAfter(/databases/$(database)/documents/profiles/$(uid)/blocked/$(resource.data.targetUid));
        allow update: if false;
      }

      match /preferences/{preferenceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && preferenceId == 'notifications'
          && request.resource.data.keys().hasAll(['like', 'reply', 'follow', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['like', 'reply', 'follow', 'updatedAt'])
          && request.resource.data.like is bool
          && request.resource.data.reply is bool
          && request.resource.data.follow is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.keys().hasAll(['type', 'actorUid', 'actorName', 'content', 'createdAt', 'read'])
          && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorName', 'postId', 'replyId', 'content', 'createdAt', 'read'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.actorName.size() <= 40
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'follow'
              && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)/following/$(uid))
              && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)/following/$(uid)).data.uid == uid)
            || (request.resource.data.type == 'like'
              && request.resource.data.postId is string
              && existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/likes/$(request.auth.uid))
              && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.uid == uid)
            || (request.resource.data.type == 'reply'
              && request.resource.data.postId is string
              && request.resource.data.replyId is string
              && existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/replies/$(request.resource.data.replyId))
              && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/replies/$(request.resource.data.replyId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.uid == uid)
          );
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }

      match /videoSignals/{videoId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['videoId', 'title', 'keywords', 'views', 'liked', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['videoId', 'title', 'keywords', 'views', 'liked', 'updatedAt', 'lastViewedAt'])
          && request.resource.data.videoId == videoId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.keywords is list
          && request.resource.data.keywords.size() <= 30
          && request.resource.data.views is int
          && request.resource.data.views >= 0
          && request.resource.data.liked is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    match /{path=**}/following/{followingId} {
      allow read: if true;
    }

    match /supportEvents/{eventId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == developerUid()
        && request.resource.data.keys().hasAll(['donorName', 'amountYen', 'testMode', 'createdByUid', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['donorName', 'amountYen', 'testMode', 'createdByUid', 'createdAt', 'updatedAt'])
        && request.resource.data.donorName is string
        && request.resource.data.donorName.size() > 0
        && request.resource.data.donorName.size() <= 40
        && request.resource.data.amountYen is int
        && request.resource.data.amountYen > 0
        && request.resource.data.amountYen <= 100000000
        && request.resource.data.testMode == true
        && request.resource.data.createdByUid == developerUid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == developerUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['donorName', 'amountYen', 'updatedAt'])
        && request.resource.data.donorName is string
        && request.resource.data.donorName.size() > 0
        && request.resource.data.donorName.size() <= 40
        && request.resource.data.amountYen is int
        && request.resource.data.amountYen > 0
        && request.resource.data.amountYen <= 100000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == developerUid();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'content', 'isAiGenerated', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorUsername', 'authorAvatarId', 'authorAvatarUrl', 'content', 'isAiGenerated', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 40
        && (!('authorAvatarId' in request.resource.data) || request.resource.data.authorAvatarId in ['google', 'octopus', 'star', 'cat', 'rabbit', 'bear', 'flower', 'custom'])
        && (!('authorAvatarUrl' in request.resource.data) || (request.resource.data.authorAvatarId == 'google' && request.resource.data.authorAvatarUrl is string && request.resource.data.authorAvatarUrl.size() <= 2048 && request.resource.data.authorAvatarUrl.matches('^https://lh[0-9]+\\.googleusercontent\\.com/.*$')))
        && (!('authorUsername' in request.resource.data) || (request.resource.data.authorUsername is string && request.resource.data.authorUsername.matches('^[a-z0-9_]{3,24}$')))
        && (!('authorUsername' in request.resource.data) || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.authorUsername)
        && request.resource.data.content is string
        && (request.resource.data.content.size() <= 500
          || (request.auth.uid == developerUid() && request.resource.data.content.size() <= 5000))
        && request.resource.data.isAiGenerated is bool
        && request.resource.data.type == 'comment'
        && request.resource.data.content.size() > 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == developerUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || request.auth.uid == developerUid());

      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && !blockedEitherWay(get(/databases/$(database)/documents/communityPosts/$(postId)).data.uid, request.auth.uid)
          && request.resource.data.keys().hasAll(['uid', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == developerUid())
          && resource.data.uid == uid;
        allow update: if false;
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && !blockedEitherWay(get(/databases/$(database)/documents/communityPosts/$(postId)).data.uid, request.auth.uid)
          && request.resource.data.keys().hasAll(['uid', 'authorName', 'content', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorAvatarId', 'authorAvatarUrl', 'content', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 40
          && (!('authorAvatarId' in request.resource.data) || request.resource.data.authorAvatarId in ['google', 'octopus', 'star', 'cat', 'rabbit', 'bear', 'flower', 'custom'])
          && (!('authorAvatarUrl' in request.resource.data) || (request.resource.data.authorAvatarId == 'google' && request.resource.data.authorAvatarUrl is string && request.resource.data.authorAvatarUrl.size() <= 2048 && request.resource.data.authorAvatarUrl.matches('^https://lh[0-9]+\\.googleusercontent\\.com/.*$')))
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && (request.resource.data.content.size() <= 500
            || (request.auth.uid == developerUid() && request.resource.data.content.size() <= 5000))
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || request.auth.uid == developerUid());
      }
    }
  }
}
