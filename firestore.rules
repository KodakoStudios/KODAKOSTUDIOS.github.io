rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'content', 'isAiGenerated', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'content', 'isAiGenerated', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.isAiGenerated is bool
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
